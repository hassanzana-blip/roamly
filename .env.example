# ── Roamly miljøvariabler ─────────────────────────────────────────────────
# Kopier til .env lokalt, eller legg inn som Variables i Railway.
# INGEN hemmeligheter skal committes til Git – denne filen inneholder kun
# plassholdere. Faktiske verdier settes i Railway-dashboardet.

# ── Database (MySQL / TiDB) ───────────────────────────────────────────────
# I Railway: legg til MySQL-plugin og referer til dens variabler, f.eks.
# mysql://${{MySQL.MYSQL_USER}}:${{MySQL.MYSQL_PASSWORD}}@${{MySQL.MYSQL_HOST}}:${{MySQL.MYSQL_PORT}}/${{MySQL.MYSQL_DATABASE}}
DATABASE_URL=

# ── Duffel (fly-API) ──────────────────────────────────────────────────────
# Bruk duffel_test_... i staging, duffel_live_... KUN i produksjon.
DUFFEL_API_KEY=
# balance = Roamlys Duffel-saldo betaler billetten
DUFFEL_PAYMENT_TYPE=balance
# Hemmelighet for webhook-signaturverifisering. Fås ved å kjøre:
#   npm run duffel:webhook
# (skrives ut ÉN gang – lim rett inn i Railway, aldri i Git)
DUFFEL_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
# production | staging | development
APP_ENV=production
# Full offentlig URL uten trailing slash, f.eks. https://roamly.no
APP_BASE_URL=
# Port webtjeneren lytter på (Railway setter PORT automatisk)
PORT=3000
# Nød-killswitch: sett til "false" for å stoppe direktebooking fra nettsiden
PUBLIC_INSTANT_BOOKING=true

# ── E-post (SMTP) ─────────────────────────────────────────────────────────
# Enten full URL: smtps://bruker:pass@smtp.utleier.no:465
SMTP_URL=
# … eller enkeltfelt:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Avsenderadresse, f.eks. Roamly <bestilling@roamly.no>
MAIL_FROM=
# Mottaker for driftsvarsler (ny booking, feilet jobb, avstemmingsavvik)
OPS_ALERT_EMAIL=

# ── Førstegangs oppsett av administratorer (engangsbruk) ──────────────────
# Eier oppgir disse sikkert via Railway Variables. De brukes kun av
#   npm run bootstrap:admins
# og kan fjernes etter at begge har aktivert kontoen sin.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
