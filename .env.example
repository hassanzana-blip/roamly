# ── HelloSky miljøvariabler ───────────────────────────────────────────────
# Kopier til .env lokalt. I produksjon settes alt som hemmeligheter hos verten
# (Railway Variables o.l.) — aldri i Git. Se DEPLOYMENT.md for full tabell.

# ── Miljø ─────────────────────────────────────────────────────────────────
# development | staging | production  (production krever live-nøkler, SMTP, PII-nøkkel, https)
APP_ENV=development
# Full offentlig URL uten trailing slash (e-postlenker, Origin-sjekk). Må være https i produksjon.
APP_BASE_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info
# Antall betrodde proxyer foran appen (klient-IP for rate limiting)
TRUSTED_PROXY_HOPS=1

# ── Database (MySQL 8 / MariaDB / TiDB) ───────────────────────────────────
DATABASE_URL=mysql://hs:hs@localhost:3306/hellosky
DB_POOL_SIZE=10

# ── Duffel (flyleverandør) ────────────────────────────────────────────────
# Tom = demomodus (kun lokalt). duffel_test_... i staging, duffel_live_... KUN i production.
DUFFEL_API_KEY=
# Fra `npm run duffel:webhook` (skrives ut én gang)
DUFFEL_WEBHOOK_SECRET=

# ── Stripe (betaling) ─────────────────────────────────────────────────────
# Begge tomme = demobetaling (kun lokalt). sk_test_/pk_test_ i staging, sk_live_/pk_live_ i production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# whsec_... fra Stripe-dashbordet (eller `stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
STRIPE_WEBHOOK_SECRET=

# ── Personvern ────────────────────────────────────────────────────────────
# 32 byte base64 for AES-256-GCM (passnummer m.m.):  openssl rand -base64 32
PII_ENCRYPTION_KEY=

# ── Booking-vern ──────────────────────────────────────────────────────────
# Nødstopp: "false" stopper direktebooking fra nettsiden
PUBLIC_INSTANT_BOOKING=true
# Øvre grense for live-bookinger per døgn i øre (0 = av). Eks. 2000000 = 20 000 kr
MAX_DAILY_LIVE_AMOUNT_MINOR=0
# Servicegebyr (kan overstyres i admin → Innstillinger)
SERVICE_FEE_PERCENT=0.08
SERVICE_FEE_FLAT_MINOR=25000

# ── E-post (SMTP) ─────────────────────────────────────────────────────────
# Enten full URL: smtps://bruker:pass@smtp.utleier.no:465
SMTP_URL=
# … eller enkeltfelt:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HelloSky <hei@hellosky.no>
# Driftsvarsler (ny booking, feilet jobb, penger i risiko, chargeback)
OPS_ALERT_EMAIL=
# Valgfri Slack-kompatibel webhook ({ text }) for samme varsler
OPS_ALERT_WEBHOOK_URL=

# ── Observability ─────────────────────────────────────────────────────────
# Valgfri Sentry-DSN (tom = ingen feilrapportering). Brukes av både web og worker.
SENTRY_DSN=
# Bearer-token for GET /metrics (Prometheus). Tom = åpent — sett alltid i produksjon.
METRICS_TOKEN=
# Kontaktinfo i e-poster
SUPPORT_PHONE=22 41 00 00
SUPPORT_EMAIL=hei@hellosky.no
SUPPORT_HOURS=06–24

# ── SMS (valgfritt) ───────────────────────────────────────────────────────
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Frontend (bakes inn ved `npm run build`) ──────────────────────────────
VITE_PUBLIC_URL=http://localhost:3000
VITE_ORG_NUMBER=
VITE_COMPANY_ADDRESS=
VITE_SUPPORT_PHONE=22 41 00 00
VITE_SERVICE_FEE_VAT_PERCENT=25

# ── Førstegangs oppsett av administratorer (engangsbruk, fjernes etterpå) ─
#   npm run bootstrap:admins
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# ── Kun utvikling/test (aldri i produksjon) ───────────────────────────────
# SKIP_ENV_SAFETY=true   # skru av produksjonssperrene
# FORCE_SERVE=true       # server dist/ utenfor NODE_ENV=production
# WORKER_MAIN=true       # start worker-løkken uansett entrypoint-navn

# ── Sosial innlogging for kunder (valgfritt) ──────────────────────────────
# En leverandør vises i innloggingen først når BEGGE variablene er satt.
# Er bare den ene satt, teller leverandøren som ikke konfigurert – en halvveis
# oppsatt OAuth-knapp er verre enn ingen knapp.
# Callback-URL som må registreres hos leverandøren:
#   https://<APP_BASE_URL>/api/auth/<leverandør>/callback
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
